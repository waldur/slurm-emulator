# Patterns to ignore when building packages.
.DS_Store
.git/
.gitignore
.bzr/
.hg/
.svn/
*.swp
*.bak
*.tmp
*.orig
*~
.project
.idea/
*.tmproj
.vscode/

# helm-unittest suites — dev-only fixtures, no place in the packaged chart.
# Anchored so it cannot also match templates/tests/, which holds the real
# `helm test` hook.
/tests/
