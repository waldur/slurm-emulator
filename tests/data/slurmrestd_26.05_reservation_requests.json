    "status": 400,
    "text": "Failure during parsing"
   }
  },
  {
   "name": "flags not a list",
   "path": "/slurm/v0.0.45/reservation",
   "body": {
    "name": "p2",
    "start_time": "now+600",
    "duration": 60,
    "node_list": "node001",
    "users": "root",
    "flags": {
     "a": 1
    }
   },
   "expect": {
    "status": 422,
    "errors": [
     {
      "description": "Expected a List but found a dictionary",
      "error_number": 9206,
