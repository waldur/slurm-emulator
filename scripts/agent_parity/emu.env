# Emulator settings for the parity run; STATE_DIR is set by emu-start.sh.
export SLURM_EMULATOR_STATE_FILE=$STATE_DIR/db.json
export SLURM_EMULATOR_TIME_FILE=$STATE_DIR/time.json
export SLURM_EMULATOR_SLURM_VERSION=26.05
export SLURM_EMULATOR_CLUSTER_NAME=demo
export SLURM_EMULATOR_PARTITIONS=debug:1-2,gpu:3-4
export SLURM_EMULATOR_JOB_CLOCK=wall
export SLURM_EMULATOR_TIME_FOLLOW_WALL=1
export SLURM_EMULATOR_JOB_RUN_DELAY=1
export SLURM_EMULATOR_JOB_RUN_DURATION=3
unset SLURM_EMULATOR_RESERVATIONS SLURM_EMULATOR_NSS SLURM_EMULATOR_JOB_EXECUTE
