+    def _has_accepted_audience(self, decoded_token: dict) -> bool:
+        # "aud" may be a single string or a list (RFC 7519, section 4.1.3).
+        audience = decoded_token.get("aud") or []
+        if isinstance(audience, str):
+            audience = [audience]
+        return any(value in self.audience for value in audience)
