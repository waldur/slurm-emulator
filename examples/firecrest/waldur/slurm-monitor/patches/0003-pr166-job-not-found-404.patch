From 5f9e56643cd54501adcf9602729de00ea62b0df3 Mon Sep 17 00:00:00 2001
From: Ilja Livenson <ilja.livenson@gmail.com>
Date: Wed, 4 Nov 2026 16:09:47 +0200
Subject: [PATCH] api: answer 404 for a job that is not found

GET /cluster/{cluster}/jobs/{job_id} returned the result of
ClusterDB.get_job as is. For a job the database does not have, or one
of another user when the caller is scoped to their own jobs, that is
None, which fails JobResponse validation and answers 500. It now
answers 404 "Job <id> not found", the same for both cases, so a user
cannot tell another user's job from a missing one.
---
 src/slurm_monitor/api/jobs.py           |  8 ++++++--
 tests/slurm_monitor/api/test_monitor.py | 23 +++++++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/src/slurm_monitor/api/jobs.py b/src/slurm_monitor/api/jobs.py
index 1cfcfc4..10e18e1 100644
--- a/src/slurm_monitor/api/jobs.py
+++ b/src/slurm_monitor/api/jobs.py
@@ -2,7 +2,7 @@ import logging
 from typing import Annotated
 
 import fastapi_pagination
-from fastapi import Depends
+from fastapi import Depends, HTTPException
 from fastapi_cache.decorator import cache
 
 from slurm_monitor.api.response_models import (
@@ -257,7 +257,7 @@ async def job_status(
     if states:
         job_states = states.split(",")
 
-    return await dbi.get_job(
+    job = await dbi.get_job(
         cluster=cluster,
         job_id=job_id,
         epoch=epoch,
@@ -266,6 +266,10 @@ async def job_status(
         end_time_in_s=end_time_in_s,
         states=job_states,
     )
+    if job is None:
+        # Also for another user's job, so a user cannot tell whether it exists.
+        raise HTTPException(status_code=404, detail=f"Job {job_id} not found")
+    return job
 
 
 @api_router.get(
diff --git a/tests/slurm_monitor/api/test_monitor.py b/tests/slurm_monitor/api/test_monitor.py
index b7d4231..3c035ae 100644
--- a/tests/slurm_monitor/api/test_monitor.py
+++ b/tests/slurm_monitor/api/test_monitor.py
@@ -17,6 +17,7 @@ from fastapi.routing import APIRoute
 from fastapi.testclient import TestClient
 from fastapi_cache import FastAPICache
 
+from slurm_monitor.api.jobs import job_status
 from slurm_monitor.api.router import app as api_app
 from slurm_monitor.app import app, prefetch_data
 from slurm_monitor.app_settings import AppSettings
@@ -609,3 +610,25 @@ async def test_bearer_token_is_not_logged(client, mock_token, caplog):
         response = client.get("/api/v2/cluster", headers={"Authorization": f"Bearer {mock_token}"})
     assert response.status_code == 200
     assert mock_token not in caplog.text
+
+
+@pytest.mark.asyncio
+async def test_unknown_job_is_not_found(client, mock_token):
+    response = client.get(
+        "/api/v2/cluster/cluster-0/jobs/999999",
+        headers={"Authorization": f"Bearer {mock_token}"},
+    )
+    assert response.status_code == 404
+    assert response.json() == {"detail": "Job 999999 not found"}
+
+
+@pytest.mark.asyncio(loop_scope="module")
+async def test_job_of_another_user_is_not_found(test_db__function_scope):
+    # The seeded jobs belong to "any-user"; job 1 is one of them.
+    job = await job_status(user="any-user", cluster="cluster-0", job_id=1, dbi=test_db__function_scope)
+    assert job.job_id == 1
+
+    with pytest.raises(fastapi.HTTPException) as raised:
+        await job_status(user="someone-else", cluster="cluster-0", job_id=1, dbi=test_db__function_scope)
+    assert raised.value.status_code == 404
+    assert raised.value.detail == "Job 1 not found"
