slurm-monitor: fetch OAuth signing keys from a configurable JWKS URL

- OAuthSettings.jwks (env SLURM_MONITOR_OAUTH_JWKS) overrides the URL the
  signing keys are fetched from. The issuer stays SLURM_MONITOR_OAUTH_URL +
  realm, so tokens issued for a public URL (here
  https://hpc-demo.preview.opnd.eu/auth/realms/kcrealm, which the container
  cannot reach) validate against keys fetched from Keycloak's internal
  address (http://keycloak:8080/auth/realms/kcrealm/protocol/openid-connect/certs).
  The name is one word because AppSettings splits env names on "_"
  (env_nested_delimiter), so SLURM_MONITOR_OAUTH_JWKS_URL would become
  oauth.jwks.url and fail validation.
- get_token_payload no longer logs the bearer token at INFO level.

diff --git a/src/slurm_monitor/api/routes.py b/src/slurm_monitor/api/routes.py
--- a/src/slurm_monitor/api/routes.py
+++ b/src/slurm_monitor/api/routes.py
@@ -164,7 +164,7 @@
         oauth2: str = Depends(oauth2_scheme)
         token = await oauth2.dependency(request)

-        logger.info(f"Retrieved token: {token}")
+        logger.debug("Retrieved bearer token")
         return await verify_token(token)

     logger.info("get_token_payload: authentication disabled")
diff --git a/src/slurm_monitor/app_settings.py b/src/slurm_monitor/app_settings.py
--- a/src/slurm_monitor/app_settings.py
+++ b/src/slurm_monitor/app_settings.py
@@ -27,6 +27,12 @@
     client_secret: str = Field(default="")
     url: str = Field(default="")
     realm: str = Field(default="")
+    # Where to fetch the signing keys, when the issuer's own certs endpoint is
+    # not reachable from the API server (e.g. the issuer is a public URL and
+    # the identity provider is reached on an internal address). One word on
+    # purpose: env_nested_delimiter="_" splits SLURM_MONITOR_OAUTH_JWKS_URL
+    # into oauth.jwks.url, so the variable is SLURM_MONITOR_OAUTH_JWKS.
+    jwks: str = Field(default="")

     @computed_field
     @property
@@ -36,7 +42,7 @@
     @computed_field
     @property
     def jwks_url(self) -> str:
-        return f"{self.issuer}/protocol/openid-connect/certs"
+        return self.jwks or f"{self.issuer}/protocol/openid-connect/certs"

     @computed_field
     @property
