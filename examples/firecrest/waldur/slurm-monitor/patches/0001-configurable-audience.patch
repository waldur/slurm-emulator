+import jwt
+import pytest
+
+from slurm_monitor.api.routes import verify_token
+from slurm_monitor.app_settings import AppSettings
+
+# A Keycloak access token's claims, as TokenPayload expects them.
+PAYLOAD = {
+    "exp": 1765187642,
+    "iat": 1765187342,
+    "jti": "onrtro:e0070d78-9c5c-04ba-22b9-fbcecb759fe4",
+    "iss": "https://example.invalid/realms/test-realm",
+    "aud": "slurm-monitor",
+    "sub": "fbf4b6c4-bdd3-4aea-8b47-3a87e9c96633",
+    "typ": "Bearer",
+    "azp": "waldur",
+    "sid": "0e7aad19-8b15-06c2-1449-616b92625b9b",
+    "acr": 1,
+    "allowed-origins": [""],
+    "realm_access": {"roles": ["default-roles-test-realm"]},
+    "resource_access": {"account": {"roles": ["view-profile"]}},
+    "scope": "email profile",
+    "email_verified": False,
+    "name": "Test User",
+    "preferred_username": "test-user",
+    "given_name": "Test",
+    "family_name": "User",
+    "email": "test-user@example.invalid",
+}
+
+
+@pytest.fixture
+def decoded(monkeypatch):
+    """Capture what verify_token asks jwt.decode to check."""
+    app_settings = AppSettings.initialize()
+    monkeypatch.setattr(app_settings.oauth, "url", "https://example.invalid")
+    monkeypatch.setattr(app_settings.oauth, "realm", "test-realm")
+
+    class SigningKey:
+        key = "signing_key"
+
+    monkeypatch.setattr(
+        app_settings.oauth.jwks_client,
+        "get_signing_key_from_jwt",
+        lambda token: SigningKey(),
+    )
+    calls = []
+
+    def fake_decode(token, key, **kwargs):
+        calls.append(kwargs)
+        return PAYLOAD
+
+    monkeypatch.setattr(jwt, "decode", fake_decode)
+    return app_settings, calls
+
+
+@pytest.mark.asyncio
+async def test_default_audience_is_keycloak_account(decoded):
+    app_settings, calls = decoded
+    await verify_token("token")
+    assert calls[0]["audience"] == ["account"]
+    assert calls[0]["options"]["verify_aud"] is True
+
+
+@pytest.mark.asyncio
+async def test_configured_audiences_are_checked(decoded, monkeypatch):
+    app_settings, calls = decoded
+    monkeypatch.setattr(app_settings.oauth, "audience", "slurm-monitor, account")
+    await verify_token("token")
+    assert calls[0]["audience"] == ["slurm-monitor", "account"]
+
+
+def test_audience_comes_from_the_environment(monkeypatch):
+    monkeypatch.setenv("SLURM_MONITOR_OAUTH_AUDIENCE", "slurm-monitor")
+    assert AppSettings().oauth.audiences == ["slurm-monitor"]
