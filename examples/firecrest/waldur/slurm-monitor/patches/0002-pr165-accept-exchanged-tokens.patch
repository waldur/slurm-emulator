From bcc3cda60127af4b08f47e7fea8b25b8e1dee6ab Mon Sep 17 00:00:00 2001
From: Ilja Livenson <ilja.livenson@gmail.com>
Date: Wed, 4 Nov 2026 12:59:36 +0200
Subject: [PATCH] auth: require only the token claims slurm-monitor uses

The token model required every claim of a Keycloak sign-in token, so a
token without one of them was refused with 401 although its signature,
expiry, issuer and audience checked out. A token exchanged for the
slurm-monitor audience (RFC 8693) carries no resource_access.account,
since Keycloak keeps only the target client's roles, and so does a
token of a user without an e-mail address or full name.

Besides exp, iss and aud, which verify_token checks (iat too, when a
token has it), only sub and preferred_username, which names the user
whose data a token may see, are required now. Missing roles count as none: a token without
realm_access sees only its own data, as before for a non-admin. The
other claims are optional.

The claim models are pydantic BaseModels instead of BaseSettings, so a
claim the token leaves out is not filled in from the environment:
before, PREFERRED_USERNAME or ROLES in the server's environment stood
in for a token's missing preferred_username or realm roles.
---
 src/slurm_monitor/api/routes.py      | 54 ++++++++++++-------
 tests/slurm_monitor/api/test_auth.py | 81 +++++++++++++++++++++++++++-
 2 files changed, 113 insertions(+), 22 deletions(-)

diff --git a/src/slurm_monitor/api/routes.py b/src/slurm_monitor/api/routes.py
index 8af9414..c12e35c 100644
--- a/src/slurm_monitor/api/routes.py
+++ b/src/slurm_monitor/api/routes.py
@@ -7,8 +7,7 @@ import jwt
 from fastapi import APIRouter, Depends, HTTPException, Request, status
 from fastapi.security import OAuth2PasswordBearer
 from fastapi_pagination import Page
-from pydantic import Field
-from pydantic_settings import BaseSettings
+from pydantic import BaseModel, Field
 
 from slurm_monitor.app_settings import AppSettings
 from slurm_monitor.utils import utcnow
@@ -33,43 +32,58 @@ class Role(str, Enum):
     ADMIN = "admin"
 
 
-class Roles(BaseSettings):
+# Token claims come from the verified token only: these are plain models, not
+# settings, so a claim the token leaves out is not filled in from the
+# process environment.
+class Roles(BaseModel):
     roles: list[str] = Field(default=[])
 
     def has_role(self, role: str) -> bool:
         return role in self.roles
 
 
-class Account(BaseSettings):
-    account: Roles
+class Account(BaseModel):
+    # The roles of Keycloak's "account" client. A token exchanged for another
+    # audience (RFC 8693) carries only that client's roles, so none here.
+    account: Roles = Field(default_factory=Roles)
 
     def has_role(self, role: str) -> bool:
         return self.account.has_role(role)
 
 
-class TokenPayload(BaseSettings):
+class TokenPayload(BaseModel):
+    """The claims of a verified access token.
+
+    verify_token checks the signature, exp, iat, aud and iss. Besides those,
+    only sub and preferred_username are required: preferred_username names the
+    user whose data the token may see. Roles default to none, which is the
+    narrowest view. The other claims are optional, since tokens exchanged for
+    slurm-monitor's audience, or issued for users without an e-mail address or
+    full name, leave some of them out.
+    """
+
     exp: int  # time in s
-    iat: int
-    jti: str
+    iat: int | None = None
+    jti: str | None = None
     iss: str  # issuer
     aud: str | list[str]  # audience: a list when the token names several
     sub: str  # subject
-    typ: str  # type: Bearer
-    azp: str  # client name
-    sid: str  #
-    acr: int
+    typ: str | None = None  # type: Bearer
+    azp: str | None = None  # client name
+    sid: str | None = None
+    acr: int | str | None = None
 
     auth_time: int | None = Field(default=None)
     allowed_origins: list[str] = Field(alias="allowed-origins", default=[])
-    realm_access: Roles
-    resource_access: Account
-    scope: str
-    email_verified: bool
-    name: str
+    realm_access: Roles = Field(default_factory=Roles)
+    resource_access: Account = Field(default_factory=Account)
+    scope: str | None = None
+    email_verified: bool | None = None
+    name: str | None = None
     preferred_username: str
-    given_name: str
-    family_name: str
-    email: str
+    given_name: str | None = None
+    family_name: str | None = None
+    email: str | None = None
 
 
 def validate_interval(end_time_in_s: float | None, start_time_in_s: float | None, resolution_in_s: int | None):
diff --git a/tests/slurm_monitor/api/test_auth.py b/tests/slurm_monitor/api/test_auth.py
index 84e7309..dba3ce6 100644
--- a/tests/slurm_monitor/api/test_auth.py
+++ b/tests/slurm_monitor/api/test_auth.py
@@ -9,7 +9,7 @@ from cryptography.hazmat.primitives.asymmetric import rsa
 from fastapi import HTTPException
 from pydantic import ValidationError
 
-from slurm_monitor.api.routes import verify_token
+from slurm_monitor.api.routes import NoneForUserWithRealmRoles, Role, verify_token
 from slurm_monitor.app_settings import AppSettings, OAuthSettings
 
 
@@ -40,7 +40,7 @@ def jwks_server():
     server.shutdown()
 
 
-def make_token(private_key, issuer: str, aud: str | list[str] = "account") -> str:
+def make_token(private_key, issuer: str, aud: str | list[str] = "account", drop: tuple[str, ...] = ()) -> str:
     now = int(time.time())
     payload = {
         "exp": now + 300,
@@ -63,6 +63,8 @@ def make_token(private_key, issuer: str, aud: str | list[str] = "account") -> st
         "family_name": "User",
         "email": "test-user@xyz.com",
     }
+    for claim in drop:
+        payload.pop(claim)
     return jwt.encode(payload, private_key, algorithm="RS256", headers={"kid": "test-key"})
 
 
@@ -143,3 +145,78 @@ def test_oauth_jwks_from_env(monkeypatch):
     settings = AppSettings()
     assert settings.oauth.issuer == "https://public.invalid/realms/test-realm"
     assert settings.oauth.jwks_url == "http://keycloak:8080/certs"
+
+
+# What Keycloak's token exchange (RFC 8693) for the slurm-monitor audience
+# leaves out of the token: the roles of other clients, and here the profile
+# claims of a user without an e-mail address or full name.
+EXCHANGED_OUT = ("resource_access", "email", "email_verified", "name", "given_name", "family_name", "sid", "acr")
+
+
+@pytest.mark.asyncio
+async def test_exchanged_token_is_accepted(monkeypatch, jwks_server):
+    jwks_url, private_key = jwks_server
+    oauth = use_oauth(monkeypatch, jwks_url, audience="slurm-monitor")
+
+    token = make_token(private_key, oauth.issuer, aud="slurm-monitor", drop=EXCHANGED_OUT)
+    token_payload = await verify_token(token)
+
+    assert token_payload.preferred_username == "test-user"
+    assert token_payload.resource_access.account.roles == []
+
+
+@pytest.mark.asyncio
+async def test_admin_role_of_an_exchanged_token_is_kept(monkeypatch, jwks_server):
+    jwks_url, private_key = jwks_server
+    oauth = use_oauth(monkeypatch, jwks_url)
+    now = int(time.time())
+    payload = {
+        "exp": now + 300,
+        "iat": now,
+        "iss": oauth.issuer,
+        "aud": "account",
+        "sub": "admin-sub",
+        "preferred_username": "admin-user",
+        "realm_access": {"roles": ["admin"]},
+    }
+    token = jwt.encode(payload, private_key, algorithm="RS256", headers={"kid": "test-key"})
+
+    token_payload = await verify_token(token)
+
+    # None: an admin is not limited to their own data
+    assert NoneForUserWithRealmRoles([Role.ADMIN])(token_payload) is None
+
+
+@pytest.mark.asyncio
+async def test_token_without_roles_sees_only_its_own(monkeypatch, jwks_server):
+    jwks_url, private_key = jwks_server
+    oauth = use_oauth(monkeypatch, jwks_url)
+
+    token_payload = await verify_token(make_token(private_key, oauth.issuer, drop=("realm_access", "resource_access")))
+
+    assert NoneForUserWithRealmRoles([Role.ADMIN])(token_payload) == "test-user"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("claim", ["preferred_username", "sub"])
+async def test_token_without_identity_is_rejected(monkeypatch, jwks_server, claim):
+    jwks_url, private_key = jwks_server
+    oauth = use_oauth(monkeypatch, jwks_url)
+
+    with pytest.raises(HTTPException) as e:
+        await verify_token(make_token(private_key, oauth.issuer, drop=(claim,)))
+    assert e.value.status_code == 401
+
+
+@pytest.mark.asyncio
+async def test_claims_are_not_taken_from_the_environment(monkeypatch, jwks_server):
+    jwks_url, private_key = jwks_server
+    oauth = use_oauth(monkeypatch, jwks_url)
+    monkeypatch.setenv("PREFERRED_USERNAME", "root")
+    monkeypatch.setenv("ROLES", '["admin"]')
+
+    with pytest.raises(HTTPException):
+        await verify_token(make_token(private_key, oauth.issuer, drop=("preferred_username",)))
+
+    token_payload = await verify_token(make_token(private_key, oauth.issuer, drop=("realm_access",)))
+    assert token_payload.realm_access.roles == []
